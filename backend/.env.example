# ============================================================
# 学生 C 第 1 阶段配置示例（复制为 backend/.env 后按需修改）
# 说明：进程环境变量优先于 .env；相对路径以仓库根目录为基准
# ============================================================

# ---- Ollama 大模型 ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3.5:4b
# 默认 15 秒，需小于前端 axios 的 20 秒超时；独立后端测试可调大
OLLAMA_TIMEOUT_SECONDS=15
# qwen3.5:4b 默认关闭思考输出（只读取 message.content）
OLLAMA_THINK=false

# ---- 检索 ----
# keyword：默认，无 embedding 依赖，读取 knowledge_base/cleaned 的 md/txt
# chroma：可选，只读 B 的 school_documents_content / school_documents_structure 集合
RETRIEVAL_MODE=keyword
KNOWLEDGE_BASE_DIR=knowledge_base/cleaned
# 向量库位置；现有 vectorstore/chroma 可显式指定为 vectorstore/chroma（不会自动搬迁）
VECTOR_DB_PATH=storage/vector_db/chroma
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
CONTENT_COLLECTION_NAME=school_documents_content
STRUCTURE_COLLECTION_NAME=school_documents_structure

# ---- 检索与上下文参数 ----
TOP_K=5
SNIPPET_MAX_CHARS=500
MAX_CONTEXT_CHARS=6000
# 可选：不设置时 keyword 模式接受任意正分，chroma 模式默认 0.35
# SCORE_THRESHOLD=0.35
# keyword 模式的通用低相关门槛（按 IDF 加权的查询词覆盖度），默认 0.2
MIN_COVERAGE=0.2
CONTENT_WEIGHT=0.6
STRUCTURE_WEIGHT=0.4

# ---- CORS（前端 Vite 开发服务器）----
CORS_ORIGINS=http://localhost:3333,http://127.0.0.1:3333

# ---- A 同学历史模块预留（C 阶段不读取、不写入）----
HISTORY_PATH=../storage/history/history.json
